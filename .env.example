# Copy to .env.local. Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/sylvias_events

# Concierge provider: google (default) or anthropic
CONCIERGE_PROVIDER=google
CONCIERGE_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe Embedded Checkout. Use test-mode keys only; live keys are rejected.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Environment variables for the Sylvia project
# Copy this file to .env.local or .env.development/.env.production as needed

# Server configuration
PORT=3000
HOST=localhost

# Database configuration (example)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# API keys and secrets (replace with actual values)
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# Application settings
NODE_ENV=development
LOG_LEVEL=info

# Additional environment variables can be added here as needed